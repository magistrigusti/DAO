# Testnet transport. Never commit a real API key or wallet session.
DOMINUM_TESTNET_API_KEY=
DOMINUM_TONCENTER_V3_URL=https://testnet.toncenter.com/api/v3
DOMINUM_TONCONNECT_MANIFEST_URL=
DOMINUM_ALLOW_CUSTOM_TESTNET_ENDPOINT=false

# Independent protocol signer wallets used by staged configuration.
DOM_MASTER= # Wallet authorized to control the Dominum master contract
DOM_TREASURY_POOL= # Wallet authorized to control the treasury pool
DOM_TREASURY_MANAGER= # Wallet authorized as the treasury manager
DOM_MINTER= # Wallet authorized to control the Dominum minter contract
DOM_MINTER_MANAGER= # Wallet authorized as the Dominum minter manager
DOM_GIVER_MANAGER= # Wallet authorized as the Dominum giver manager

# Independent owner wallets for the nine recipient contracts.
DOM_ALLODIUM_FRS= # Wallet owning the Allodium FRS recipient
DOM_ALLODIUM_FOUNDATION= # Wallet owning the Allodium foundation
DOM_DEFI_MARKET= # Wallet owning the DeFi market recipient contract
DOM_DEFI_FOUNDRY= # Wallet owning the DeFi foundry recipient contract
DOM_DEFI= # Wallet owning the main DeFi treasury recipient contract
DOM_DAO_BANK= # Wallet owning the DAO bank recipient contract
DOM_DAO_FOUNDATION= # Wallet owning the DAO foundation recipient
DOM_DOMINUM_BANK= # Wallet owning the Dominum bank recipient contract
DOM_DOMINUM_FOUNDATION= # Wallet owning the Dominum foundation

# Allodium bootstrap owners and canonical off-chain metadata.
ALLOD_MASTER_OWNER_ADDRESS= # Wallet owning the Allodium master contract
ALLOD_GAS_POOL_AUTHORITY_ADDRESS= # Wallet controlling the gas pool
# Leave empty to use metadata/allod-metadata.json from main.
ALLOD_METADATA_URL= # HTTPS address of the Allodium token metadata

# Addresses printed by deploy:allodium:testnet.
ALLODIUM_MASTER_ADDRESS=
ALLODIUM_GAS_POOL_ADDRESS=

# Existing external testnet contracts required by recipient storage.
DEFI_FOUNDATION_ADDRESS=
DEFI_FOUNDRY_RELEASE_ADDRESS=
DOM_RECIPIENT_OWNER_CODE_HASH=

# Eight addresses printed by deploy:dom:recipients:testnet.
DOM_RECIPIENT_ALLODIUM_FRS_ADDRESS=
DOM_RECIPIENT_ALLODIUM_FOUNDATION_ADDRESS=
DOM_RECIPIENT_DEFI_MARKET_ADDRESS=
DOM_RECIPIENT_DEFI_FOUNDRY_ADDRESS=
DOM_RECIPIENT_DEFI_TREASURY_ADDRESS=
DOM_RECIPIENT_DAO_BANK_ADDRESS=
DOM_RECIPIENT_DAO_FOUNDATION_ADDRESS=
DOM_RECIPIENT_DOMINUM_FOUNDATION_ADDRESS=

# BankDominum and the core addresses printed by deploy:dom:testnet.
DOM_RECIPIENT_DOMINUM_BANK_ADDRESS=
DOM_DEPLOYER_ADDRESS=
DOM_TREASURY_MANAGER_ADDRESS=
DOM_TREASURY_POOL_ADDRESS=
DOM_GAS_POOL_ADDRESS=
DOM_GIVER_MANAGER_ADDRESS=
DOM_MINTER_MANAGER_ADDRESS=
DOM_MINTER_ADDRESS=
DOM_MASTER_ADDRESS=
DOM_GIVER_ALLODIUM_ADDRESS=
DOM_GIVER_DEFI_ADDRESS=
DOM_GIVER_DAO_ADDRESS=
DOM_GIVER_DOMINUM_ADDRESS=

# One action is executed per wallet connection and process run.
DOM_CONFIG_ACTION=status
DOM_RECIPIENT_ACTION=status

# Allodium actions: master-frs-init, gas-master-init or gas-top-up.
ALLODIUM_CONFIG_ACTION=
